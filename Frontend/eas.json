{
  "cli": {
    "version": ">= 12.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      } 
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
    //Production tiene que ser aab(Android App Bundle) para subirse a google play, luego google play genera un apk optimizado.
    //Production tiene que distribution:Store, si se deja como distribution:internal, se toma por omisión
    // el perfil "Preview".
  },
  "submit": {
    "production": {}
  }
}
